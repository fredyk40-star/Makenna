# App Configuration
VITE_APP_TITLE=Makenna Learning Lab
VITE_APP_VERSION=1.0.0
VITE_APP_TAGLINE=Watch • Play • Learn • Grow

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_OFFLINE_CACHE_NAME=makenna-lab-v1

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PUSH_NOTIFICATIONS=false

# API Configuration (for future use)
VITE_API_URL=http://localhost:3000

# Cloud sync uses serverless functions only. Do NOT put a Supabase URL or anon
# key in VITE_* variables - the browser no longer reads tables directly.
# Configure the server values below instead.

# Cloud Sync Settings
VITE_ENABLE_CLOUD_SYNC=true
VITE_ENABLE_SYNC_NOTIFICATIONS=true

VITE_ENABLE_PARENT_AUTH=true
VITE_DEVELOPER_EMAIL=addaifrederick72@gmail.com

# Developer auth (server-side only - never prefix these with VITE_)
# Generate a hash with: node scripts/hash-developer-password.js "your-strong-password"
DEVELOPER_EMAIL=addaifrederick72@gmail.com
DEVELOPER_PASSWORD_HASH=
DEVELOPER_PASSWORD_SALT=
DEVELOPER_JWT_SECRET=

# Signs child device tokens used by cloud sync. Required in production.
CHILD_SESSION_SECRET=

# Data store selection. Supabase is the default; TiDB is used only after the
# TiDB adapter has been tested and cutover is explicitly approved.
DATA_STORE=supabase

# Server-side Supabase access (all child/support/developer data)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# TiDB Cloud MySQL-compatible mode. All server-side only; never use VITE_*.
# Leave blank while DATA_STORE=supabase. TIDB_CA is optional when the runtime
# trust store already contains TiDB Cloud's certificate authority.
TIDB_HOST=
TIDB_PORT=4000
TIDB_DATABASE=
TIDB_USER=
TIDB_PASSWORD=
TIDB_CA=
TIDB_POOL_LIMIT=3
TIDB_MAX_IDLE=1

# Gmail SMTP mailer (use a Google Account App Password, not the account password)
GMAIL_USER=addaifrederick72@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_FROM=addaifrederick72@gmail.com
APP_URL=https://makenna.vercel.app

# Optional online tutor (server-side only; never use a VITE_ prefix)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
